# Grok Bot (Cursor/Anysphere). Same definition the grok-bot RPM's %post
# writes, with a priority added by backend_repo_add. The RPMs in this repo are
# signed with Anysphere's key (380F F4BC DC34 A4BD 92A3 5653 42A1 772E 62E4 92D6);
# the api2.cursor.sh direct downloads are unsigned and fail Fedora 45's
# rpm 6.1 (%_pkgverify_level all), so the app is installed from here.
[grok-bot]
name=Grok Bot
baseurl=https://downloads.cursor.com/yumrepo/grok-bot
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://downloads.cursor.com/keys/anysphere.asc
skip_if_unavailable=1
