#!/bin/bash 
set -euo pipefail
# Install dir for hyacinth-macaw
INSTALL_DIR="/usr/immutablue-build-hyacinth-macaw"
cd "$INSTALL_DIR/artifacts/utilities"

# On systmd login / scripts PATH won't have the brew 
# install of `just` if on x86_64
type just 2>/dev/null >/dev/null 
if [ $? -eq 0 ]; then export PATH="$HOME/../linuxbrew/.linuxbrew/bin:$PATH"; fi

if [ $# -lt 1 ]
then 
    exec just --choose
fi 

exec just "$@"

